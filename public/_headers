# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# obrázky a videa z public/ nemají v názvu hash, takže je nejde zamknout
# napořád jako /_next/static - týden načisto, pak měsíc ze stale, než se to
# na pozadí přeověří. při výměně souboru počítej s tím zpožděním
/images/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=2592000

/videos/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=2592000

/*
  # prohlížeč nesmí hádat typ obsahu podle těla odpovědi
  X-Content-Type-Options: nosniff
  # při odchodu na cizí web se posílá jen doména, ne celá URL
  Referrer-Policy: strict-origin-when-cross-origin
  # web nic z tohohle nepoužívá, tak ať to nemůže použít ani vložený skript
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # cizí stránka si web nesmí načíst do iframu (clickjacking)
  X-Frame-Options: DENY
